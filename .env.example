# EcoSort - environment configuration.
#
# Every variable here already has a working default (docs/ARCHITECTURE.md section 7), so
# `docker compose up --build` works with no .env file at all. Copy this file to .env only
# when you want to change something:
#
#   cp .env.example .env

# Node runtime mode: development | production
NODE_ENV=development

# Host port for the Express API (the container always listens on 4000 internally).
BACKEND_PORT=4000

# Host port for the Vite dev server.
FRONTEND_PORT=5173

# Host port for the nginx production frontend (docker-compose.prod.yml only).
FRONTEND_PROD_PORT=8080

# Directory holding the SQLite database. /data in the container, ./backend/data on the host.
DATA_DIR=/data

# Full path to the SQLite database file.
DB_FILE=/data/ecosort.db

# Bind-mounted models directory; holds custom/ after training. Takes priority over the bundled copy.
MODELS_DIR=/models

# Model directory baked into the backend image at build time (pretrained MobileNetV2 fallback).
BUNDLED_MODELS_DIR=/app/bundled-models

# Comma-separated list of allowed browser origins, or * to allow any.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Maximum length in characters of an inbound image data URL; longer bodies get 413.
MAX_IMAGE_DATA_URL=400000

# Backend log verbosity: error | warn | info | debug
LOG_LEVEL=info

# Default recycling region used when the client does not choose one.
DEFAULT_REGION=us-generic

# Frontend API base URL. Leave empty to use same-origin requests through the Vite/nginx proxy.
VITE_API_BASE=

# Where the Vite dev-server proxy forwards /api and /models. Compose overrides this to http://backend:4000.
VITE_PROXY_TARGET=http://localhost:4000

# Extra hostnames the Vite dev server will accept in the Host header, comma-separated.
# Vite blocks unknown hosts to prevent DNS rebinding. localhost and the common dev-tunnel
# suffixes (.trycloudflare.com, .ngrok-free.app, .loca.lt, .devtunnels.ms, ...) are already
# allowed, so you only need this for a custom domain. `*` allows any host and turns the
# protection off - fine on a trusted network, not on a shared one.
VITE_ALLOWED_HOSTS=

# Only needed when reaching the dev server through an HTTPS tunnel. The page arrives on 443
# but the HMR client would otherwise dial 5173 over plain ws and fail, filling the console
# with connection errors. For `cloudflared tunnel --url http://localhost:5173` use:
#   VITE_HMR_CLIENT_PORT=443
#   VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=
VITE_HMR_PROTOCOL=

# Set to true only if file-watching HMR does not fire on your host (macOS/Windows/VM bind mounts).
CHOKIDAR_USEPOLLING=false
